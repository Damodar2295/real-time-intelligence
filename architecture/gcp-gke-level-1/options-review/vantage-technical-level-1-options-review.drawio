        <mxCell id="detection" value="&lt;b&gt;Existing detection &amp;amp; output&lt;/b&gt;&lt;br&gt;Selective methods → evidence resolution&lt;br&gt;Acceptance / completion rules OPEN&lt;br&gt;Publication and later activation retained" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=21;fontColor=#002663;fillColor=#EAF4FF;strokeColor=#006FCF;spacing=14;align=left;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1" sourceRefs="" componentId="detection" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
