        <mxCell id="legend" value="&lt;b&gt;READING GUIDE&lt;/b&gt;&lt;br&gt;Amber dashed cards/links = proposed alternatives • Purple = test source • Containers describe choices, not deployed security zones.&lt;br&gt;Page 1 preserves baseline dependencies; this page expands decision options without selecting technologies or changing V4." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=21;fontColor=#002663;fillColor=#FFFFFF;strokeColor=#FFFFFF;spacing=14;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1" sourceRefs="" componentId="legend" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
