  <diagram id="vantage-options-evaluation" name="Handoff &amp; Windowing | Alternatives">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-title" value="&lt;b&gt;VANTAGE Intelligence | Handoff &amp;amp; Windowing | Alternatives&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=30;fontColor=#002663;fillColor=#FFFFFF;strokeColor=#FFFFFF;spacing=14;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1" sourceRefs="" componentId="page-title" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
          <mxGeometry as="geometry" x="40" y="15" width="2320" height="55" />
        </mxCell>
        <mxCell id="page-subtitle" value="13 October 2026 • Evaluation choices, not approved topology • Both sources use the same selected processing path&lt;br&gt;Choose one handoff per configuration. No dual publishing, source-specific broker, or automatic fallback implied." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#002663;fillColor=#FFFFFF;strokeColor=#FFFFFF;spacing=14;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1" sourceRefs="" componentId="page-subtitle" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
