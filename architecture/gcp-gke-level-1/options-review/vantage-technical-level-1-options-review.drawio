        <mxCell id="local-option" value="C • COLOCATED PROTOTYPE OPTION" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=21;fontColor=#002663;fillColor=#EAF4FF;strokeColor=#B7C9D3;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=44;horizontal=1;fillColor=#002663;swimlaneFillColor=#EAF4FF;fontColor=#FFFFFF;fontStyle=1;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1" sourceRefs="" componentId="local-option" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
