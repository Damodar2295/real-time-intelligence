          <mxGeometry as="geometry" x="40" y="1250" width="2310" height="270" />
        </mxCell>
        <mxCell id="platform-note" value="Confirm Pub/Sub / Redis / model access and supported versions with Lumi. GKE remains target; no Cloud Run migration implied.&lt;br&gt;Choose stores separately for call context, catalog/versioning, vectors, and accepted evidence. PostgreSQL direction retained provisionally.&lt;br&gt;History writer, threshold policy, acceptable loss and security ownership remain decisions. No zero-latency or lossless guarantee." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=22;fontColor=#002663;fillColor=#FFFFFF;strokeColor=#FFFFFF;spacing=14;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="platform" sourceRefs="" componentId="platform-note" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
