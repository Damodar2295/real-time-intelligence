        </mxCell>
        <mxCell id="local-inner" value="&lt;b&gt;Ingress → bounded local queue → processing&lt;/b&gt;&lt;br&gt;Inside one application process&lt;br&gt;Not a shared cross-instance broker&lt;br&gt;Restart loss, overload and call placement OPEN" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=22;fontColor=#002663;fillColor=#FFFFFF;strokeColor=#B29145;spacing=14;align=left;verticalAlign=middle;dashed=1;dashPattern=7 4;" vertex="1" parent="local-option" sourceRefs="" componentId="local-inner" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
          <mxGeometry as="geometry" x="25" y="75" width="670" height="210" />
        </mxCell>
        <mxCell id="window-options" value="WINDOW ASSEMBLY • SEPARATE DECISION" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=21;fontColor=#002663;fillColor=#EAF4FF;strokeColor=#B7C9D3;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=44;horizontal=1;fillColor=#002663;swimlaneFillColor=#EAF4FF;fontColor=#FFFFFF;fontStyle=1;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1" sourceRefs="" componentId="window-options" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
