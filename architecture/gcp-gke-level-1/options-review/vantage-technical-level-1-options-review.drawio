        </mxCell>
        <mxCell id="window-a" value="&lt;b&gt;Retain V4: workers assemble windows&lt;/b&gt;&lt;br&gt;Ingress frames transcript events before handoff." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=21;fontColor=#002663;fillColor=#FFFFFF;strokeColor=#A5BAC8;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="window-options" sourceRefs="" componentId="window-a" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
