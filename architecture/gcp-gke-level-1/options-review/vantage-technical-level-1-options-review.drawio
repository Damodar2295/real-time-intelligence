          <mxGeometry as="geometry" x="40" y="180" width="480" height="470" />
        </mxCell>
        <mxCell id="live" value="&lt;b&gt;Genesys source&lt;/b&gt;&lt;br&gt;Provider transcript events OR&lt;br&gt;audio → acquisition → STT&lt;br&gt;Contract / coexistence OPEN" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=21;fontColor=#002663;fillColor=#EEF3F8;strokeColor=#839CAE;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="source-zone" sourceRefs="" componentId="live" decisionStatus="NOTATION" deploymentStatus="NOT VERIFIED">
